DATABASE_URL=postgresql+psycopg://agent_autopsy:agent_autopsy@127.0.0.1:55432/agent_autopsy
TEST_DATABASE_URL=postgresql+psycopg://agent_autopsy:agent_autopsy@127.0.0.1:55432/agent_autopsy_test
# Default real model provider: local Ollama. No API key or paid cloud model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:latest
# Optional paid OpenAI mode. Keep credentials on the backend only.
# Choose a Responses/function-calling model; no default model is substituted.
# Preflight only: uv run --env-file .env python -m app.validate_model --provider openai
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Opt in after starting the local collector: bash scripts/start-phoenix.sh
AGENT_AUTOPSY_TRACING_ENABLED=false
PHOENIX_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces

# HTTP execution uses durable jobs by default. Start a separate worker process.
# Inline CLI commands remain available; legacy synchronous HTTP is opt-in debugging only.
AGENT_AUTOPSY_SYNC_API_ENABLED=false
# Explicit browser origins; Docker Compose sets these to its published frontend port.
AGENT_AUTOPSY_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
